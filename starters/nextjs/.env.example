# Synthetic local settings only. For compose, copy this file to .env.
# Use URL-safe letters, digits and underscores for these local credentials.
POSTGRES_USER=cofa
POSTGRES_DB=cofa_app
POSTGRES_PASSWORD=cofa_local_password
APP_PORT=3000
# Compose sets DATABASE_URL using the variables above and the internal db host.
# For npm run dev/start outside Docker, use a separately reachable PostgreSQL:
# DATABASE_URL=postgresql://cofa:cofa_local_password@127.0.0.1:5432/cofa_app
# Opt-in real DB tests: a separate database named cofa_test is mandatory.
# TEST_DATABASE_URL=postgresql://cofa:cofa_local_password@127.0.0.1:5432/cofa_test
# Tests read shell environment variables; they do not load .env automatically.
