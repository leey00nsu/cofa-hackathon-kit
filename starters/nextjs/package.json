{
  "name": "cofa-nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "start": "node scripts/start.mjs",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test --test-concurrency=1 --test-reporter=tap tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
